{
  // Isolated opencode config for the digester's HEADLESS extraction calls.
  //
  // WHY THIS EXISTS: extraction feeds UNTRUSTED source documents (transcripts,
  // PDFs of unknown provenance) to a model. Mark's personal
  // ~/.config/opencode/opencode.jsonc sets bash / edit / read / webfetch /
  // websearch / task / skill to "allow" for interactive work - pointing an agent
  // with filesystem and shell access at an untrusted document is a live
  // prompt-injection surface: a document containing instructions could get them
  // executed. The Claude path runs `--tools ""` for exactly this reason.
  //
  // Selected via OPENCODE_CONFIG=<this file> so Mark's interactive config is never
  // touched or overridden.
  //
  // Defence in depth - BOTH mechanisms, because either alone is one bug from open:
  //   1. every permission denied, and
  //   2. an `extract` agent with every tool switched off.
  // Run with `--pure` as well so external plugins cannot reintroduce a tool.
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "deny",
    "read": "deny",
    "edit": "deny",
    "write": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "patch": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "todowrite": "deny",
    "todoread": "deny",
    "question": "deny",
    "task": "deny",
    "skill": "deny",
    "lsp": "deny"
  },
  "agent": {
    "extract": {
      "description": "Headless structured extraction over untrusted documents. No tools.",
      "mode": "primary",
      "tools": {
        "bash": false,
        "read": false,
        "edit": false,
        "write": false,
        "glob": false,
        "grep": false,
        "list": false,
        "patch": false,
        "webfetch": false,
        "websearch": false,
        "todowrite": false,
        "todoread": false,
        "question": false,
        "task": false,
        "skill": false,
        "lsp": false
      }
    }
  }
}
